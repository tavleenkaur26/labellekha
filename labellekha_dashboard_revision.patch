@@ -142,14 +142,32 @@ body{background:var(--bg);color:var(--ink)}
 .compact-stat-grid .stat-card strong{font-size:20px;margin-top:2px}
 .compact-stat-grid .stat-card small{display:block;color:var(--muted);font-size:10.5px;margin-top:2px}
 
-.overview-grid{grid-template-columns:1.7fr 1fr}
-.activity-panel .panel-header{align-items:center}
-.volume-figure{text-align:right}
-.volume-figure strong{display:block;font-size:20px;line-height:1.1}
-.volume-figure span{font-size:10.5px;color:var(--muted)}
-.mix-row{display:flex;align-items:center;gap:16px;margin-top:10px;padding-top:14px;border-top:1px solid var(--line-soft)}
-.mix-row .donut-legend{flex:1;gap:8px}
-.mix-row .donut-legend div{grid-template-columns:8px 1fr auto;font-size:11px}
+.section-eyebrow{display:block;font:600 10px 'IBM Plex Mono',monospace;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);margin-bottom:3px}
+
+/* ---- inspection priority: the dominant operational section ---- */
+.priority-console{margin-bottom:16px}
+.priority-list{display:flex;flex-direction:column}
+.priority-row{display:grid;grid-template-columns:88px 1.4fr 1fr auto;align-items:center;gap:14px;padding:9px 4px;border-top:1px solid var(--line-soft);cursor:pointer;font-size:12px}
+.priority-list .priority-row:first-child{border-top:0}
+.priority-row:hover{background:var(--surface-soft)}
+.priority-main strong{display:block;font-size:12.5px}
+.priority-main small{color:var(--muted);font-size:11px}
+.priority-reason{color:var(--muted);font-size:11px}
+.priority-metric{font:600 11px 'IBM Plex Mono',monospace;color:var(--ink);white-space:nowrap;text-align:right}
+
+/* ---- recent inspections (primary) + compact analytics rail ---- */
+.console-grid{display:grid;grid-template-columns:1.9fr 1fr;gap:14px;align-items:start}
+.compact-table th,.compact-table td{padding:7px 10px;font-size:12px}
+.analytics-rail{gap:12px}
+.compact-panel{padding:13px 15px}
+.compact-panel .panel-header{margin-bottom:8px}
+.compact-bars{gap:8px}
+.compact-bars .bar-row{grid-template-columns:80px 1fr 24px;font-size:10.5px}
+.activity-note p{font-size:11.5px;line-height:1.5}
+
+.mix-row{display:flex;align-items:center;gap:14px}
+.mix-row .donut-legend{flex:1;gap:6px}
+.mix-row .donut-legend div{grid-template-columns:7px 1fr auto;font-size:10.5px}
 .mix-row .donut-legend i{width:7px;height:7px;border-radius:50%}
 .dot-good{background:var(--green)}
 .dot-bad{background:var(--red)}
@@ -157,20 +175,21 @@ body{background:var(--bg);color:var(--ink)}
