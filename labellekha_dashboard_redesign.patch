+
+/* ======================================================================
+   DASHBOARD / OVERVIEW REDESIGN — additive, reuses shell tokens above
+   ====================================================================== */
+
+.compact-stat-grid{grid-template-columns:repeat(4,1fr)}
+.compact-stat-grid .stat-card{display:flex;align-items:center;gap:12px;padding:14px 16px}
+.stat-icon{width:34px;height:34px;border-radius:var(--radius-sm);display:grid;place-items:center;font-size:15px;flex:none}
+.compact-stat-grid .stat-card span{font-size:11px;color:var(--muted)}
+.compact-stat-grid .stat-card strong{font-size:20px;margin-top:2px}
+.compact-stat-grid .stat-card small{display:block;color:var(--muted);font-size:10.5px;margin-top:2px}
+
+.overview-grid{grid-template-columns:1.7fr 1fr}
+.activity-panel .panel-header{align-items:center}
+.volume-figure{text-align:right}
+.volume-figure strong{display:block;font-size:20px;line-height:1.1}
+.volume-figure span{font-size:10.5px;color:var(--muted)}
+.mix-row{display:flex;align-items:center;gap:16px;margin-top:10px;padding-top:14px;border-top:1px solid var(--line-soft)}
+.mix-row .donut-legend{flex:1;gap:8px}
+.mix-row .donut-legend div{grid-template-columns:8px 1fr auto;font-size:11px}
+.mix-row .donut-legend i{width:7px;height:7px;border-radius:50%}
+.dot-good{background:var(--green)}
+.dot-bad{background:var(--red)}
+.dot-warn{background:var(--amber)}
+.slice-good{fill:var(--green)}
+.slice-bad{fill:var(--red)}
+
+.breakdown-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}
+.bar-row i{background:var(--accent)}
+
+.row-actions{display:flex;gap:6px}
+.icon-action{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:var(--radius-sm);font-size:10px;text-transform:uppercase;letter-spacing:.04em;padding:4px 7px;font-family:'IBM Plex Mono',monospace}
+.icon-action:hover{border-color:var(--accent);color:var(--accent-hover)}
+.queue-row.clickable{cursor:pointer}
+.queue-row.clickable:hover{background:var(--surface-soft)}
+
+@media(max-width:1100px){
+  .overview-grid{grid-template-columns:1fr}
+  .breakdown-grid{grid-template-columns:1fr}
+}
+@media(max-width:650px){
+  .compact-stat-grid{grid-template-columns:1fr 1fr}
+  .mix-row{flex-direction:column;align-items:flex-start}
+}
