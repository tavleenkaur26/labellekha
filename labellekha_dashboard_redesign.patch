+// The backend has no dedicated time-series endpoint for inspection volume.
+// Rather than inventing numbers, this buckets the scan records the page has
+// already fetched (via GET /scans) by their real `created_at` timestamp —
+// a client-side aggregation of real records, not fabricated data.
+function buildActivitySeries(scans: ScanListItem[]) {
+  const today = new Date();
+  today.setHours(0, 0, 0, 0);
+  const days = Array.from({ length: 7 }, (_, i) => {
+    const d = new Date(today);
+    d.setDate(d.getDate() - (6 - i));
+    return { time: d.getTime(), label: d.toLocaleDateString(undefined, { day: '2-digit', month: 'short' }), value: 0 };
+  });
+  scans.forEach((s) => {
+    const c = new Date(s.created_at);
+    c.setHours(0, 0, 0, 0);
+    const day = days.find((d) => d.time === c.getTime());
+    if (day) day.value += 1;
+  });
+  return days;
+}
+
+// Real count of scans from 7–13 days ago, from the same fetched list, used
+// only to show a genuine week-over-week comparison (no invented trend).
+function previousWindowCount(scans: ScanListItem[]) {
+  const today = new Date();
+  today.setHours(0, 0, 0, 0);
+  return scans.filter((s) => {
+    const c = new Date(s.created_at);
+    c.setHours(0, 0, 0, 0);
+    const diffDays = Math.round((today.getTime() - c.getTime()) / 86400000);
+    return diffDays >= 7 && diffDays <= 13;
+  }).length;
+}
 
