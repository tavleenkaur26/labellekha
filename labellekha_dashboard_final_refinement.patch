+                  <div><i style={{ width: `${pct(row.value, clauseData[0].value)}%` }} /></div>
+                  <span>{row.value}</span>
+                </div>
+              ))}
+            </div>
+          ) : <p className="muted">No clause violations in this selection.</p>}
+        </div>
+      </div>
 
       {loading && <div className="dashboard-loading">Refreshing dashboard data…</div>}
     </Page>
